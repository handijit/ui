{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    /* `@handijitcom/ui/design` is not mapped: it resolves through the package exports to
       `build/design`, so the declarations keep importing it by name. */
    "paths": {
      "@handijitcom/ui": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "build",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/design"
  ]
}
